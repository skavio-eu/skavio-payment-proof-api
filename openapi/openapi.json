  "components": {
    "securitySchemes": {
      "PaymentProofBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Payment Proof skp_ key only; read for GET, write for POST. No cookie fallback."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "RequestCreate": {
        "type": "object",
        "properties": {
          "wallet_id": {
            "type": "string"
          },
          "amount_usdc": {
            "type": "string",
            "example": "29.00"
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 350
          },
          "customer_label": {
            "type": "string"
          },
          "expected_payer": {
            "type": "string"
          },
          "valid_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          }
        },
        "required": [
          "wallet_id",
          "amount_usdc",
          "description"
        ],
        "additionalProperties": false
      },
      "Request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "wallet_id": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "receiver_address": {
            "type": "string"
          },
          "customer_label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "amount_atomic": {
            "type": "integer",
            "minimum": 1,
            "description": "Native USDC atomic units (six decimals); pay exact amount including matching delta."
          },
          "quoted_amount_atomic": {
            "type": "integer",
            "minimum": 1,
            "description": "Native USDC atomic units (six decimals); pay exact amount including matching delta."
          },
          "expected_payer": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "integer"
          },
          "expires_at": {
            "type": "integer"
          },
          "tx_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified_at": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "network",
          "amount_atomic",
          "status",
          "url"
        ]
      },
      "ContactCreate": {
        "type": "object",
        "properties": {
          "legal_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "address": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "legal_name",
          "email"
        ],
        "additionalProperties": false
      },
      "Contact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "legal_name",
          "email"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "unit_usdc": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "quantity",
          "unit_usdc"
        ]
      },
      "InvoiceCreate": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string"
          },
          "wallet_id": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "minItems": 1
          },
          "tax_mode": {
            "type": "string"
          },
          "tax_rate": {
            "type": "string"
          },
          "tax_usdc": {
            "type": "string"
          },
          "tax_notes": {
            "type": "string"
          },
          "accounting": {
            "type": "object",
            "description": "Existing dashboard accounting validation applies; see reference."
          },
          "send_now": {
            "const": false
          },
          "reminder_opt_in": {
            "const": false
          },
          "customer_receipt_opt_in": {
            "const": false
          }
        },
        "required": [
          "customer_id",
          "wallet_id",
          "due_date",
          "items"
        ],
        "additionalProperties": false
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "customer_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "receiver": {
            "type": "string"
          },
          "issued_at": {
            "type": "integer"
          },
          "due_at": {
            "type": "integer"
          },
          "total_atomic": {
            "type": "integer",
            "minimum": 1,
            "description": "Native USDC atomic units (six decimals); pay exact amount including matching delta."
          },
          "payment_atomic": {
            "type": "integer",
            "minimum": 1,
            "description": "Native USDC atomic units (six decimals); pay exact amount including matching delta."
          },
          "tax_atomic": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "id",
          "request_id",
          "status",
          "payment_atomic"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "api_version": {
            "const": "1.0"
          },
          "id": {
            "type": "string"
          },
          "plan": {
            "type": "object",
            "description": "Current plan, request/invoice quotas, api_key_limit and webhook_limit."
          },
          "wallets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "network": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "network",
                "address"
              ]
            }
          }
        },
        "required": [
          "id",
          "plan",
          "wallets"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "api_version": {
            "const": "1.0"
          },
          "type": {
            "enum": [
              "payment_request.created",
              "invoice.issued",
              "invoice.voided",
              "payment.confirmed",
              "invoice.paid"
            ]
          },
          "occurred_at": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              },
              "invoice_id": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "network": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "amount_atomic": {
                "type": "integer",
                "minimum": 1,
                "description": "Native USDC atomic units (six decimals); pay exact amount including matching delta."
              },
              "quoted_amount_atomic": {
                "type": "integer",
                "minimum": 1,
                "description": "Native USDC atomic units (six decimals); pay exact amount including matching delta."
              },
              "tx_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified_at": {
                "type": "integer"
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "api_version",
          "type",
          "occurred_at",
          "data"
        ]
      },
      "SendApproval": {
        "type": "object",
        "properties": {
          "user_approved": {
            "const": true
          }
        },
        "required": [
          "user_approved"
        ],
        "additionalProperties": false
      },
      "SendResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "mail_status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "mail_status"
        ]
      }
    }
  },
  "webhooks": {
    "proofEvent": {
      "post": {
        "summary": "Signed event to registered public HTTPS endpoint; raw-byte HMAC verification required",
        "parameters": [
          {
            "name": "X-Skavio-Timestamp",
            "in": "header",
            "required": true,
            "description": "Unix seconds; reject clock difference >300 seconds",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Skavio-Signature",
            "in": "header",
            "required": true,
            "description": "v1=<64 lowercase hex>; HMAC SHA256 of timestamp + dot + untouched body bytes",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Skavio-Event-Id",
            "in": "header",
            "required": true,
            "description": "Must match signed body id; durable deduplication key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Skavio-Delivery-Id",
            "in": "header",
            "required": true,
            "description": "Stable delivery ID across retries",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Skavio-Key-Version",
            "in": "header",
            "required": true,
            "description": "Signing secret version",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Return 2xx only after atomic durable dedup/business outbox commit; retries retain event/delivery IDs."
          }
        }
      }
    }
  }
}
