    "/v1/events": {
      "get": {
        "summary": "Retained event stream; not historical delivery replay",
        "security": [
          {
            "PaymentProofBearer": []
          }
        ],
        "x-required-scope": "read",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cursor": {
                            "type": "integer"
                          },
                          "event": {
                            "$ref": "#/components/schemas/Event"
                          }
                        },
                        "required": []
                      }
                    },
                    "next_cursor": {
                      "type": "integer"
                    }
                  },
                  "required": []
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, inactive or insufficient scope key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-site or customer-access denial",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing or foreign resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Validation or quota failure",
            "content": {
