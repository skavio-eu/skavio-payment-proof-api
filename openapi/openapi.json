{
  "openapi": "3.1.0",
  "info": {
    "title": "Skavio Payment Proof REST API",
    "version": "1.0",
    "description": "Implementation reference; deployment and live E2E not claimed. Native USDC /30 days: Starter 9 (1 key/1 hook), Business 19 (3/3), Pro 29 (10/10); API/webhooks bundled. Seven-day trial 1/1. Generic Make/n8n/WooCommerce HTTP recipes, not official connectors. Mutations cannot confirm payments. Payment confirmation requires matching verified blockchain ledger evidence. Bearer read/write scopes; management uses dashboard cookie + CSRF. At-least-once signed delivery, durable dedup required; max five attempts. See /developers/reference."
  },
  "servers": [
    {
      "url": "https://www.skavio.eu/proof",
      "description": "Intended public prefix; availability pending deployment"
    }
  ],
