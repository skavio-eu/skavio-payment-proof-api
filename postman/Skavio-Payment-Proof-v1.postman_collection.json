{
  "info": {
    "name": "Skavio Payment Proof v1 \u2014 SDK 1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "LOCAL REVIEW TEMPLATE. Do not run against real customers. No Processing API, transfers or wallet signing. OpenAPI is REST source of truth. Persist idempotency_key per operation; clear it only for a new operation. Webhook verification must use SDK raw-byte verifier and durable dedup; mock script below is illustrative only."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{payment_proof_api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://www.skavio.eu/proof"
    },
    {
      "key": "payment_proof_api_key",
      "value": ""
    },
    {
      "key": "idempotency_key",
      "value": ""
    },
    {
      "key": "resource_id",
      "value": "SYNTHETIC_RESOURCE_ID"
    },
    {
      "key": "csrf_token",
      "value": ""
    },
    {
      "key": "key_id",
      "value": "SYNTHETIC_KEY_ID"
    },
    {
      "key": "webhook_id",
      "value": "SYNTHETIC_WEBHOOK_ID"
    },
    {
      "key": "delivery_id",
      "value": "SYNTHETIC_DELIVERY_ID"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.method === 'POST' && !pm.variables.get('idempotency_key')) { pm.variables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}')); }"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Synthetic HMAC demonstration only; SDK verifies actual raw bytes, timestamp and event ID.",
          "const CryptoJS = require('crypto-js');",
          "const raw = '{\"id\":\"evt_synthetic\",\"api_version\":\"1.0\"}';",
          "const timestamp = '1791720000';",
          "const signature = CryptoJS.HmacSHA256(timestamp + '.' + raw, 'synthetic-only-secret').toString();",
          "pm.test('Synthetic webhook HMAC has SHA256 length', () => pm.expect(signature.length).to.equal(64));",
          "// Never use this demonstration as a production receiver or durable dedup store."
        ]
      }
    }
  ],
